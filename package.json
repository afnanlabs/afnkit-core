{
  "name": "afnkit",
  "version": "0.1.0",
  "description": "Afnkit is an original, educational Express-inspired HTTP framework built on Node.js native HTTP APIs in TypeScript.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/tests/*.test.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "express",
    "http",
    "framework",
    "router",
    "middleware",
    "typescript",
    "educational"
  ],
  "author": "Afnan Khan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afnanlabs/afnkit-core.git"
  },
  "homepage": "https://github.com/afnanlabs/afnkit-core#readme",
  "bugs": {
    "url": "https://github.com/afnanlabs/afnkit-core/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
